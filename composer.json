{
    "name": "mrandmrssmith/idempotent-symfony-messenger-consumer-bundle",
    "description": "idempotent-consumer-bundle",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^7.4 || ^8.0",
        "ext-json": "*",
        "symfony/messenger": "^4.4 || ^5.4 || ^6.4 || ^7.4",
        "symfony/serializer": "4.4 || ^5.4 || ^6.4 || ^7.4",
        "symfony/property-access": "4.4 || ^5.4 || ^6.4 || ^7.4",
        "symfony/dependency-injection": "^3.4 || ^4.4 || ^5.4 || ^6.4 || ^7.4",
        "mrandmrssmith/idempotent-consumer-bundle": "^1.0 || ^2.0"
    },
    "authors": [
        {
            "name": "Michal Boryczko",
            "email": "michal.boryczko@smithhotels.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "MrAndMrsSmith\\IdempotentConsumerSymfonyMessengerBundle\\": "./src",
            "Tests\\UnitTests\\" : "./tests/UnitTests"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "require-dev": {
        "phpstan/phpstan": "^1.10",
        "phpstan/phpstan-phpunit": "^1.3",
        "phpunit/phpunit": ">=8.5",
        "symplify/easy-coding-standard": "^12.1",
        "vimeo/psalm": "^4.30||^5.22"
    },
    "repositories": [
        {
            "type": "git",
            "url": "https://github.com/mrandmrssmith/idempotent-consumer-bundle.git"
        }
    ]
}
